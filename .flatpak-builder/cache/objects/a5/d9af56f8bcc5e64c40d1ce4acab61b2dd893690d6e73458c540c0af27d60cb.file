[Application]
name=org.tiwut.NeofetchGui
runtime=org.gnome.Platform/x86_64/47
sdk=org.gnome.Sdk/x86_64/47
command=neofetch-gui

[Context]
sockets=x11;wayland;
devices=dri;
filesystems=host;

[Extension org.tiwut.NeofetchGui.Locale]
directory=share/runtime/locale
autodelete=true
locale-subset=true

[Extension org.tiwut.NeofetchGui.Debug]
directory=lib/debug
autodelete=true
no-autodownload=true

[Build]
built-extensions=org.tiwut.NeofetchGui.Locale;org.tiwut.NeofetchGui.Debug;